# Spanyolrét Gardens. Copy to .env.local for local work, set on Vercel for production.
# This repository is PUBLIC: no value below may ever be written in the code or committed here.
# Names only.
#
# Every lead channel is optional: a missing variable skips that channel (the log says
# "... not configured: channel skipped"), the others still run. If NO capture channel at
# all is configured and working (Synphos OS, Google Sheet, email), the form returns an
# error (503) rather than thanking a visitor whose lead would be lost.

# --- Site address -------------------------------------------------------------
# Public address of the site, without trailing slash (e.g. https://your-domain).
# When set, the lead route refuses any POST whose Origin is another site. Set it for
# Production only: a preview deployment lives on another host and would be refused.
NEXT_PUBLIC_SITE_URL=
# Also read when the site is built: it is the base of the canonical, hreflang, Open Graph image
# and sitemap URLs. Without it (local work, a preview) those URLs stay relative.

# --- Search engines -----------------------------------------------------------
# Noindex by default (page tag, X-Robots-Tag header, empty sitemap): an accidental deployment
# is never indexed. Only the exact value `true` opens the site. Set it for Production only,
# and leave it unset on Preview. Read when the site is built: redeploy after changing it.
# public/Spanyolret-gardens.pdf is noindex whatever this says.
ALLOW_INDEXING=

# --- Email notification (Resend) ----------------------------------------------
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. Spanyolret Gardens <noreply@your-domain>
LEAD_EMAIL_FROM=
# Comma-separated recipients of the new-lead notification.
LEAD_EMAIL_TO=

# --- Google Sheet CRM ---------------------------------------------------------
# The id is the long string in the sheet's URL: /spreadsheets/d/<ID>/edit
GOOGLE_SHEET_ID=
# Tab name. Defaults to Leads when empty. The lead is appended to columns A:Q.
GOOGLE_SHEET_TAB=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- Synphos OS (buyer pipeline) ----------------------------------------------
# All three are needed; one missing = channel skipped.
SYNPHOS_OS_URL=
SYNPHOS_OS_LEADS_TOKEN=
# Name under which the OS files this project's leads (the project's slug).
SYNPHOS_OS_CLIENT=

# --- Meta ---------------------------------------------------------------------
# Digits only. Enables the browser Pixel (loaded only after the visitor accepts cookies)
# and, with the token below, the Conversions API. It is read when the site is built:
# set it BEFORE the deployment that must use it.
NEXT_PUBLIC_META_PIXEL_ID=
# Conversions API access token. The server-side Lead event is sent only for a visitor
# who accepted cookies.
META_CONVERSIONS_API_TOKEN=

# --- Mixpanel (visit statistics) ----------------------------------------------
# Project token of the Mixpanel project for this site (names only here, never the value).
# Mixpanel starts only after the visitor accepts cookies; without a token nothing is sent.
# Read when the site is built: set it BEFORE the deployment that must use it.
NEXT_PUBLIC_MIXPANEL_TOKEN=
# EU data residency: https://api-eu.mixpanel.com (the project must be an EU project).
NEXT_PUBLIC_MIXPANEL_API_HOST=

# --- Lead rate limit (optional) -----------------------------------------------
# Limits form submissions per IP. Needs a Redis with an Upstash-compatible REST API:
# a free Upstash database, or the Upstash / KV integration on Vercel (which sets
# KV_REST_API_* or UPSTASH_REDIS_REST_*, both also read here). Both empty: the limit is
# off and every request goes through. Store down: requests go through too.
RATE_LIMIT_REDIS_REST_URL=
RATE_LIMIT_REDIS_REST_TOKEN=
# Any random string; only a salted hash of the IP is stored. Defaults to the project name.
RATE_LIMIT_SALT=
# Defaults: 5 submissions per IP per 3600 seconds.
LEAD_RATE_LIMIT_MAX=
LEAD_RATE_LIMIT_WINDOW_SECONDS=
